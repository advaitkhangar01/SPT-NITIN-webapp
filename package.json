{
  "name": "spt-quotation-invoice-maker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --skip-generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node prisma/seed.js",
    "test:audit": "node scripts/verify-audit.js",
    "test:pdf": "node scripts/test-pdf-regression.js",
    "test": "npm run test:audit && npm run test:pdf",
    "db:push": "prisma db push",
    "db:init": "prisma db push && node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.3",
    "lucide-react": "^0.441.0",
    "next": "14.2.11",
    "puppeteer": "^23.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4"
  }
}
