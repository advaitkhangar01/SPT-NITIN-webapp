# Port to run the application on (choose an unused port on your VPS)
PORT=3005

# Node Environment
NODE_ENV=production

# SQLite Database path (Prisma resolves relative path from prisma/ directory)
DATABASE_URL="file:./dev.db"

# Secret key for JWT session tokens (generate a random 32+ character string for production)
JWT_SECRET=spt-secret-key-change-this-in-production-2026

# Optional: Explicit path to Chromium/Chrome if required on your VPS distribution
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
